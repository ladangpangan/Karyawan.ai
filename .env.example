# Salin ke .env lalu isi. JANGAN commit .env (sudah di .gitignore).
TZ=Asia/Jakarta

# ---------- Multica ----------
MULTICA_IMAGE_TAG=latest
MULTICA_POSTGRES_DB=multica
MULTICA_POSTGRES_USER=multica
MULTICA_POSTGRES_PASSWORD=
# openssl rand -hex 32
MULTICA_JWT_SECRET=
MULTICA_APP_URL=http://localhost:3000
MULTICA_PUBLIC_URL=
MULTICA_COOKIE_DOMAIN=
MULTICA_FRONTEND_PORT=3000
MULTICA_BACKEND_PORT=8080
MULTICA_ALLOW_SIGNUP=true
MULTICA_ALLOWED_EMAILS=
MULTICA_ALLOWED_EMAIL_DOMAINS=
MULTICA_RESEND_API_KEY=
MULTICA_SMTP_HOST=
MULTICA_SMTP_PORT=25
MULTICA_SMTP_USERNAME=
MULTICA_SMTP_PASSWORD=
MULTICA_SMTP_FROM_EMAIL=
MULTICA_GOOGLE_CLIENT_ID=
MULTICA_GOOGLE_CLIENT_SECRET=
MULTICA_LLM_API_KEY=
MULTICA_LLM_BASE_URL=
MULTICA_LLM_DEFAULT_MODEL=
MULTICA_TRUSTED_PROXIES=

# ---------- Hermes Agent ----------
# API key model (OpenRouter, Anthropic, dll.) disimpan di $HERMES_DATA_DIR/.env,
# bukan di sini — lihat hermes-agent/config/.env.example
HERMES_IMAGE_TAG=latest
HERMES_DATA_DIR=~/.hermes
HERMES_UID=10000
HERMES_GID=10000

# ---------- n8n ----------
N8N_IMAGE_TAG=latest
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
# Pakai key yang SAMA dengan instance lama (lihat ~/.n8n/config di container lama)
N8N_ENCRYPTION_KEY=
