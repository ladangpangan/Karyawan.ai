    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nconst teks = b.teks_presisi || {};\n\n// Model di OpenRouter (Seedream). \"nano-banana-pro\" = kualitas final, \"nano-banana\" = draf cepat.\nconst MODEL = {\n  'nano-banana-pro': 'bytedance-seed/seedream-4.5',\n  'nano-banana': 'bytedance-seed/seedream-5-0-lite',\n};\nconst model = b.model === 'nano-banana' ? 'nano-banana' : 'nano-banana-pro';\n\n// Rasio: ambil \"4:5\" dari \"4:5 1080x1350\", atau hitung dari \"1080x1350\".\nconst dim = String(b.dimensi);\nlet ratio = (dim.match(/\\d+\\s*:\\s*\\d+/) || [''])[0].replace(/\\s/g, '');\nconst px = dim.match(/(\\d{3,5})\\s*[x×]\\s*(\\d{3,5})/);\nif (!ratio && px) {\n  const g = (a, c) => (c ? g(c, a % c) : a);\n  const d = g(+px[1], +px[2]);\n  ratio = `${px[1] / d}:${px[2] / d}`;\n}\nratio = ratio || '1:1';\n\nconst label = { headline: 'Headline (largest, most prominent)', subheadline: 'Subheadline', harga: 'Price badge', cta: 'Call-to-action button' };\nconst teksLines = Object.entries(teks)\n  .filter(([, v]) => v !== null && String(v).trim() !== '')\n  .map(([k, v]) => `- ${label[k] || k}: \"${String(v).trim()}\"`);\n\nconst parts = [\n  `Professional ${b.jenis_materi} design, aspect ratio ${ratio}${px ? ` (${px[1]}x${px[2]} px)` : ''}, full-bleed composition filling the entire ${ratio} frame.`,\n  String(b.deskripsi_visual).trim(),\n  teksLines.length\n    ? `TEXT TO RENDER — render ONLY these texts, spelled EXACTLY as written (keep capitalization, numbers and \"Rp\" format), sharp and highly legible, with clear hierarchy:\\n${teksLines.join('\\n')}\\nDo not add any other words.`\n    : 'Do not render any text, letters or numbers in the image.',\n  b.catatan_brand ? `Brand guidelines: ${b.catatan_brand}` : '',\n  'Quality: award-winning commercial advertising design, appetizing, ultra detailed, crisp edges, balanced negative space, high contrast between text and background.',\n  'Avoid: misspelled or garbled text, extra random text, watermark, fake or third-party logos, cluttered layout, deformed or plastic-looking food, claims/prices/promos not listed above.',\n].filter(Boolean);\n\nreturn [{ json: {\n  issue_id: String(b.issue_id),\n  jenis_materi: b.jenis_materi,\n  model,\n  openrouter_model: MODEL[model],\n  dimensi: dim,\n  aspect_ratio: ratio,\n  teks_presisi: teks,\n  prompt: parts.join('\\n\\n'),\n} }];"
      },
